_default:
    @just --list

# Build the backend, optionally optimized for release.
[group('build')]
build $mode='':
    #!/bin/sh
    set -eu

    case "$mode" in
      '') cargo build ;;
      --release) cargo build --release ;;
      *)
        printf 'usage: just build [--release]\n' >&2
        exit 2
        ;;
    esac

# Lint all backend targets with warnings denied.
[group('quality')]
check:
    cargo clippy --all-targets -- -D warnings

# Run the backend test suite.
[group('quality')]
test:
    cargo test

# Create a new SQLx migration.
[group('database')]
add-migration $name:
    cargo sqlx migrate add "$name"

# Regenerate SQLx query metadata using a temporary database.
[group('database')]
prepare:
    #!/usr/bin/env -S pgdb /bin/sh
    set -eu

    cargo sqlx migrate run
    cargo sqlx prepare
