_default:
    @just --list

# Build the backend and frontend, optionally for release.
[group('build')]
build $mode='':
    just --justfile backend/justfile build "$mode"
    just --justfile frontend/justfile build "$mode"

# Build the production Nix package.
[group('build')]
package:
    nix build

# Build and supervise the application and persistent development database.
[group('development')]
[positional-arguments]
dev *args: build
    mkdir -p .dev
    process-compose --use-uds --unix-socket .dev/process-compose.sock --ordered-shutdown up "$@"

# Run the backend with the database environment supplied by Process Compose.
_serve:
    #!/bin/sh
    set -eu

    exec cargo run --manifest-path backend/Cargo.toml -- - <<EOF
    listen_address = "127.0.0.1:0"
    database_url = "$DATABASE_URL"
    frontend = "frontend/dist"
    log_filter = "debug"
    EOF

# Format all project sources.
[group('quality')]
format:
    nix fmt

# Run package static and build checks.
[group('quality')]
check:
    just --justfile backend/justfile check
    just --justfile frontend/justfile check
    process-compose --dry-run

# Run the project test suite.
[group('quality')]
test:
    just --justfile backend/justfile test

# Validate formatting, packages, and NixOS integration.
[group('quality')]
flake-check:
    nix flake check
